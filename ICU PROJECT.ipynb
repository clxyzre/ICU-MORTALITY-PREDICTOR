   "source": [
    "# Key lab item IDs\n",
    "lab_items = {\n",
    "    50912: 'creatinine',\n",
    "    50971: 'potassium',\n",
    "    50983: 'sodium',\n",
    "    50902: 'chloride',\n",
    "    50882: 'bicarbonate',\n",
    "    51222: 'hemoglobin',\n",
    "    51265: 'platelets',\n",
    "    51301: 'wbc'\n",
    "}\n",
    "\n",
    "labevents['valuenum'] = pd.to_numeric(labevents['valuenum'], errors='coerce')\n",
    "\n",

    "lab_filtered = labevents[labevents['itemid'].isin(lab_items.keys())].copy()\n",
    "lab_filtered['lab_name'] = lab_filtered['itemid'].map(lab_items)\n",
    "\n",
    "# Mean lab value per admission\n",
    "lab_features = lab_filtered.groupby(\n",
    "    ['subject_id', 'hadm_id', 'lab_name']\n",
    ")['valuenum'].mean().unstack(fill_value=np.nan)\n",
    "\n",
    "lab_features.columns = [f'mean_{c}' for c in lab_features.columns]\n",
    "lab_features = lab_features.reset_index()\n",
    "\n",
    "print(f\"Lab features shape: {lab_features.shape}\")\n",
    "print(lab_features.head())"
