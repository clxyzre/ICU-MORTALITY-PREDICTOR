   "source": [
    "# Merge patients with admissions\n",
    "df = admissions.merge(patients, on='subject_id')\n",
    "\n",
    "# Target: did this patient die in hospital?\n",
    "df['mortality'] = (df['hospital_expire_flag'] == 1).astype(int)\n",
    "\n",
    "# Calculate LOS from admit and discharge times\n",
    "icustays['intime'] = pd.to_datetime(icustays['intime'])\n",
    "icustays['outtime'] = pd.to_datetime(icustays['outtime'])\n",
    "icustays['los'] = (icustays['outtime'] - icustays['intime']).dt.total_seconds() / 86400\n",
    "\n",
    "print(icustays[['subject_id', 'hadm_id', 'los']].head())\n",
    "# Merge in ICU stay info\n",
    "df = df.merge(icustays[['subject_id', 'hadm_id', 'los']], \n",
    "              on=['subject_id', 'hadm_id'], \n",
    "              how='left')\n",
    "\n",
    "print(f\"Total admissions: {len(df)}\")\n",
    "print(f\"Mortality rate: {df['mortality'].mean():.2%}\")\n",
    "print(f\"Survived: {(df['mortality'] == 0).sum()}\")\n",
    "print(f\"Died: {(df['mortality'] == 1).sum()}\")\n",
    "print(df[['subject_id', 'mortality', 'los']].head(10))"
   ]
  },
