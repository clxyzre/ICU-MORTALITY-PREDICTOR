   "source": [
    "# Convert times to datetime\n",
    "chartevents['charttime'] = pd.to_datetime(chartevents['charttime'])\n",
    "admissions['admittime']  = pd.to_datetime(admissions['admittime'])\n",
    "\n",
    
    "chart = chartevents.merge(\n",
    "    admissions[['subject_id', 'hadm_id', 'admittime']], \n",
    "    on=['subject_id', 'hadm_id']\n",
    ")\n",
    "\n",
    "# Calculate hours since admission\n",
    "chart['hours_in'] = (chart['charttime'] - chart['admittime']).dt.total_seconds() / 3600\n",
    "\n",
    "# Keep only first 24 hours\n",
    "chart_24h = chart[chart['hours_in'] <= 24].copy()\n",
    "\n",
    "# Key vital sign item IDs in MIMIC\n",
    "vital_items = {\n",
    "    211:  'heart_rate',\n",
    "    618:  'respiratory_rate', \n",
    "    646:  'spo2',\n",
    "    807:  'glucose',\n",
    "    220045: 'heart_rate_alt',\n",
    "    220210: 'respiratory_rate_alt'\n",
    "}\n",
    "\n",

    "chart_vitals = chart_24h[chart_24h['itemid'].isin(vital_items.keys())].copy()\n",
    "chart_vitals['vital_name'] = chart_vitals['itemid'].map(vital_items)\n",
    "chart_vitals['valuenum'] = pd.to_numeric(chart_vitals['valuenum'], errors='coerce')\n",
    "\n",
    "# Compute mean vital signs per admission in first 24 hours\n",
    "vitals_features = chart_vitals.groupby(\n",
    "    ['subject_id', 'hadm_id', 'vital_name']\n",
    ")['valuenum'].mean().unstack(fill_value=np.nan)\n",
    "\n",
    "vitals_features.columns = [f'mean_{c}' for c in vitals_features.columns]\n",
    "vitals_features = vitals_features.reset_index()\n",
    "\n",
    "print(f\"Vital features shape: {vitals_features.shape}\")\n",
    "print(vitals_features.head())"
   ]
  },
