    "master = df[['subject_id', 'hadm_id', 'mortality', 'los']].copy()\n",
    "\n",
    "# Add patient age\n",
  
    "patients['dob'] = pd.to_datetime(patients['dob'])\n",
    "admissions['admittime'] = pd.to_datetime(admissions['admittime'])\n",
    "\n",
    "age_df = admissions[['subject_id', 'hadm_id', 'admittime']].merge(\n",
    "    patients[['subject_id', 'dob', 'gender']], on='subject_id'\n",
    ")\n",
    "\n",

    "def safe_age(row):\n",
    "    try:\n",
    "        days = (row['admittime'] - row['dob']).days\n",
    "        age = days / 365.25\n",
           
    "        return min(age, 90)\n",
    "    except:\n",
    "        return np.nan\n",
    "\n",
    "age_df['age'] = age_df.apply(safe_age, axis=1)\n",
    "age_df['gender_male'] = (age_df['gender'] == 'M').astype(int)\n",
    "\n",
    "print(f\"Age range: {age_df['age'].min():.1f} to {age_df['age'].max():.1f}\")\n",
    "print(age_df[['subject_id', 'age', 'gender_male']].head(10))\n",
    "\n",
 
    "master = master.merge(vitals_features, on=['subject_id', 'hadm_id'], how='left')\n",
    "\n",
  
    "master = master.merge(lab_features, on=['subject_id', 'hadm_id'], how='left')\n",
    "\n",

    "master = master.drop(columns=['subject_id', 'hadm_id'])\n",
    "\n",
    "print(f\"Master dataset shape: {master.shape}\")\n",
    "print(f\"Columns: {list(master.columns)}\")\n",
    "print(f\"Missing values:\\n{master.isnull().sum()}\")"
   ]
  },
